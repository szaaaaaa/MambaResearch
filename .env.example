# 至少配置一个 LLM provider 的 API key
# 推荐使用 OpenRouter（统一入口，支持多种模型）
OPENROUTER_API_KEY=

# 或者直接使用各供应商的 key
OPENAI_API_KEY=
GEMINI_API_KEY=

# 搜索增强（可选）
SERPAPI_API_KEY=
SILICONFLOW_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
BING_API_KEY=
GITHUB_TOKEN=

# Claude Code 作为实验执行引擎（详见 docs/archive/setup-claude-code.md）
# 使用 Claude Max / Pro 订阅时这些全部留空；API Key 模式或 router 场景才需要填
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_CODE_DEFAULT_MODEL=
CLAUDE_CODE_TIMEOUT=
