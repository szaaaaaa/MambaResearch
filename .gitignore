.env
.env.*
!.env.example
*.pem
*.key

# IDE
.vscode/
.idea/

# Build artifacts
build/
dist/
*.egg-info/

# Runtime data
data/
outputs/
logs/
evolved_skills/
*.log
.pytest_cache/
