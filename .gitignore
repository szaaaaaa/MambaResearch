# Local DB / index artifacts
*.sqlite
*.db
*.bin

# Claude Code — exclude .claude/ children (worktrees, hooks, local state).
# .claude/skills/ is intentionally excluded: after running scripts/skills_mirror.ps1
# it becomes a directory of NTFS junctions pointing into .skills-shared/, which
# git cannot represent portably. The physical SKILL.md files live in .skills-shared/.
.claude/*
!.claude/agents/
!.claude/agents/**

# Codex — exclude .codex/ children (local state, history, cache) but keep
# .codex/agents/ (auto-generated from .claude/agents/ via scripts/sync_subagents.py)
# and .codex/config.toml (project-level MCP for codex app-server; Task 5).
# .codex/skills/ is excluded for the same junction reason as .claude/skills/.
.codex/*
!.codex/agents/
!.codex/agents/**
!.codex/config.toml

# Skills mirror — physical source of truth for both Claude / Codex skill loaders.
# .claude/skills/<name> and .codex/skills/<name> are NTFS junctions pointing here.
# Tracked in git so team members get the same skills after running skills_mirror.ps1.
!.skills-shared/
!.skills-shared/**

# Self-improvement — project-local Claude learnings, personal dev memory
.learnings/

# continues (cli-continues) cross-tool handoff file — regenerated per resume
.continues-handoff.md

# MambaResearch project meta — `<project>/.mambaresearch/` is created in any
# directory registered as an active project. The 主仓库 itself is occasionally
# used as a project (debugging / dev-mode), so ignore the dir at repo root too.
.mambaresearch/
